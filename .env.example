COMPOSE_PROJECT_NAME=northstar-dev
# Compose derives SESSION_COOKIE_NAME from its project name to isolate browser sessions.
WEB_PORT=8080
MAILPIT_PORT=8025
POSTGRES_PASSWORD=replace-with-local-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
